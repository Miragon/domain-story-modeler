{
  "name": "@miragon/domain-story-modeler",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "apps/vscode/*",
    "libs/*",
    "libs/vscode/*"
  ],
  "scripts": {
    "build": "npm-run-all -s build:libs -p build:webview build:plugin",
    "build:libs": "npm-run-all -p build:lib:diagram-js build:lib:domain-story build:lib:dtos",
    "build:lib:diagram-js": "yarn workspace @egon/diagram-js-egon-plugin build",
    "build:lib:domain-story": "yarn workspace @egon/vscode-domain-story build",
    "build:lib:dtos": "yarn workspace @egon/vscode-data-transfer-objects build",
    "build:webview": "yarn workspace egon-modeler-webview build",
    "build:plugin": "yarn workspace egon-modeler-plugin build",
    "dev": "npm-run-all -s build:lib:diagram-js -p dev:libs dev:webview dev:plugin",
    "dev:libs": "npm-run-all -p dev:lib:diagram-js dev:lib:domain-story dev:lib:dtos",
    "dev:lib:diagram-js": "yarn workspace @egon/diagram-js-egon-plugin dev",
    "dev:lib:domain-story": "yarn workspace @egon/vscode-domain-story dev",
    "dev:lib:dtos": "yarn workspace @egon/vscode-data-transfer-objects dev",
    "dev:webview": "yarn workspace egon-modeler-webview dev",
    "dev:plugin": "yarn workspace egon-modeler-plugin dev",
    "serve": "npm-run-all -s dev:lib:diagram-js -p \"dev:lib:diagram-js -- --watch\" serve:webview",
    "serve:webview": "yarn workspace egon-modeler-webview serve",
    "test": "npm-run-all -p test:jest test:vitest",
    "test:jest": "jest --coverage --coverageReporters=clover",
    "test:vitest": "yarn workspace @egon/diagram-js-egon-plugin test",
    "lint": "eslint ."
  },
  "dependencies": {
    "bpmn-font": "0.12.1",
    "diagram-js": "15.2.4",
    "diagram-js-direct-editing": "3.2.0",
    "diagram-js-minimap": "5.2.0",
    "didi": "10.2.2",
    "dot": "1.1.3",
    "ids": "1.0.5",
    "inherits-browser": "0.1.0",
    "lodash": "4.18.1",
    "min-dash": "4.2.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "tiny-svg": "4.1.3",
    "tslib": "2.8.1",
    "tsyringe": "4.8.0",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/jasmine": "5.1.6",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.16",
    "@types/node": "22.13.4",
    "@types/vscode": "1.98.0",
    "@types/vscode-webview": "1.57.5",
    "@typescript-eslint/utils": "8.24.0",
    "@vitest/coverage-v8": "4.1.11",
    "copy-webpack-plugin": "12.0.2",
    "corepack": "0.36.0",
    "eslint": "9.20.1",
    "eslint-config-prettier": "9.1.0",
    "jasmine-core": "5.6.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-environment-node": "29.7.0",
    "jsdom": "22.1.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.1",
    "sass": "1.93.3",
    "terser-webpack-plugin": "5.3.11",
    "ts-archlint": "0.15.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.4.3",
    "vite-plugin-dts": "3.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11",
    "webpack": "5.102.1",
    "webpack-cli": "6.0.1",
    "webpack-merge": "6.0.1",
    "zip-build": "1.8.0"
  },
  "resolutions": {
    "form-data": "4.0.6",
    "shell-quote": "1.10.0",
    "tar": "7.5.22"
  }
}
