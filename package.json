{
  "name": "@miragon/domain-story-modeler",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "npm-run-all -s build:libs clean:extension -p build:webview build:plugin",
    "clean:extension": "node -e \"require('node:fs').rmSync('dist/apps/vscode-plugin',{recursive:true,force:true})\"",
    "build:libs": "npm-run-all -p build:lib:core build:lib:shared build:lib:types",
    "build:lib:core": "yarn workspace @egon/modeler-core build",
    "build:lib:shared": "yarn workspace @egon/modeler-shared build",
    "build:lib:types": "yarn workspace @egon/modeler-types build",
    "build:webview": "yarn workspace egon-modeler-webview build",
    "build:plugin": "yarn workspace egon-modeler-plugin build",
    "dev": "npm-run-all -p dev:libs dev:webview dev:plugin",
    "dev:libs": "npm-run-all -p dev:lib:core dev:lib:shared dev:lib:types",
    "dev:lib:core": "yarn workspace @egon/modeler-core dev",
    "dev:lib:shared": "yarn workspace @egon/modeler-shared dev",
    "dev:lib:types": "yarn workspace @egon/modeler-types dev",
    "dev:webview": "yarn workspace egon-modeler-webview dev",
    "dev:plugin": "yarn workspace egon-modeler-plugin dev",
    "serve": "yarn serve:webview",
    "serve:webview": "yarn workspace egon-modeler-webview serve",
    "typecheck": "npm-run-all -p typecheck:core typecheck:shared typecheck:types typecheck:webview typecheck:plugin typecheck:tests typecheck:extension",
    "typecheck:core": "tsc -p libs/modeler-core/tsconfig.lib.json --noEmit",
    "typecheck:shared": "tsc -p libs/modeler-shared/tsconfig.lib.json --noEmit",
    "typecheck:types": "tsc -p libs/modeler-types/tsconfig.lib.json --noEmit",
    "typecheck:webview": "tsc -p apps/egn-webview/tsconfig.app.json --noEmit",
    "typecheck:plugin": "tsc -p apps/vscode-plugin/tsconfig.app.json --noEmit",
    "typecheck:tests": "npm-run-all -p typecheck:tests:webview typecheck:tests:core typecheck:tests:shared typecheck:tests:types typecheck:tests:plugin",
    "typecheck:tests:webview": "tsc -p apps/egn-webview/tsconfig.spec.json --noEmit",
    "typecheck:tests:core": "tsc -p libs/modeler-core/tsconfig.spec.json --noEmit",
    "typecheck:tests:shared": "tsc -p libs/modeler-shared/tsconfig.spec.json --noEmit",
    "typecheck:tests:types": "tsc -p libs/modeler-types/tsconfig.spec.json --noEmit",
    "typecheck:tests:plugin": "tsc -p apps/vscode-plugin/tsconfig.spec.json --noEmit",
    "typecheck:extension": "tsc -p test/extension/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:browser": "vitest run --config apps/egn-webview/vitest.browser.config.ts",
    "test:artifacts": "node test/artifacts/protocol-artifacts.cjs",
    "package": "node test/package/package.cjs",
    "test:package": "node test/package/contracts.cjs",
    "build:extension-tests": "tsc -p test/extension/tsconfig.json",
    "test:extension": "yarn build:extension-tests && node test/extension/run.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "lodash": "4.18.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/lodash": "4.17.26",
    "@types/mocha": "10.0.10",
    "@types/node": "22.13.4",
    "@types/vscode": "1.140.0",
    "@types/vscode-webview": "1.57.5",
    "@typescript-eslint/utils": "8.72.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "copy-webpack-plugin": "12.0.2",
    "corepack": "0.36.0",
    "eslint": "9.20.1",
    "eslint-config-prettier": "9.1.0",
    "jsdom": "22.1.0",
    "mocha": "12.0.2",
    "npm-run-all": "4.1.5",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vite-plugin-dts": "3.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11",
    "webpack": "5.112.0",
    "webpack-cli": "6.0.1",
    "webpack-merge": "6.0.1",
    "yauzl": "3.4.0",
    "zip-build": "1.8.0"
  },
  "resolutions": {
    "dompurify": "3.4.17",
    "form-data": "4.0.6",
    "shell-quote": "1.12.0",
    "tar": "7.5.22"
  }
}
