{
  "name": "@miragon/domain-story-modeler",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "npm-run-all -s build:libs -p build:webview build:plugin",
    "build:libs": "npm-run-all -p build:lib:core build:lib:shared build:lib:types",
    "build:lib:core": "yarn workspace @egon/modeler-core build",
    "build:lib:shared": "yarn workspace @egon/modeler-shared build",
    "build:lib:types": "yarn workspace @egon/modeler-types build",
    "build:webview": "yarn workspace egon-modeler-webview build",
    "build:plugin": "yarn workspace egon-modeler-plugin build",
    "dev": "npm-run-all -p dev:libs dev:webview dev:plugin",
    "dev:libs": "npm-run-all -p dev:lib:core dev:lib:shared dev:lib:types",
    "dev:lib:core": "yarn workspace @egon/modeler-core dev",
    "dev:lib:shared": "yarn workspace @egon/modeler-shared dev",
    "dev:lib:types": "yarn workspace @egon/modeler-types dev",
    "dev:webview": "yarn workspace egon-modeler-webview dev",
    "dev:plugin": "yarn workspace egon-modeler-plugin dev",
    "serve": "yarn serve:webview",
    "serve:webview": "yarn workspace egon-modeler-webview serve",
    "typecheck": "npm-run-all -p typecheck:core typecheck:shared typecheck:types typecheck:webview typecheck:plugin",
    "typecheck:core": "tsc -p libs/modeler-core/tsconfig.lib.json --noEmit",
    "typecheck:shared": "tsc -p libs/modeler-shared/tsconfig.lib.json --noEmit",
    "typecheck:types": "tsc -p libs/modeler-types/tsconfig.lib.json --noEmit",
    "typecheck:webview": "tsc -p apps/egn-webview/tsconfig.app.json --noEmit",
    "typecheck:plugin": "tsc -p apps/vscode-plugin/tsconfig.app.json --noEmit",
    "test": "vitest run --coverage",
    "test:artifacts": "node test/artifacts/protocol-artifacts.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "lodash": "4.18.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/lodash": "4.17.16",
    "@types/node": "26.6.3",
    "@types/vscode": "1.98.0",
    "@types/vscode-webview": "1.57.5",
    "@typescript-eslint/utils": "8.24.0",
    "@vitest/coverage-v8": "5.0.2",
    "copy-webpack-plugin": "14.0.0",
    "corepack": "0.36.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.1",
    "terser-webpack-plugin": "5.3.11",
    "ts-archlint": "0.15.0",
    "ts-loader": "9.5.4",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.24.0",
    "vite": "8.3.1",
    "vite-plugin-dts": "5.1.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.2",
    "webpack": "5.102.1",
    "webpack-cli": "7.2.3",
    "webpack-merge": "6.0.1",
    "zip-build": "1.8.0"
  },
  "resolutions": {
    "form-data": "4.0.6",
    "shell-quote": "1.10.0",
    "tar": "7.5.22"
  }
}
