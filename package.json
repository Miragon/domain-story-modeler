{
  "name": "@miragon/domain-story-modeler",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/vscode/*"
  ],
  "scripts": {
    "build": "npm-run-all -s build:libs -p build:webview build:plugin",
    "build:libs": "npm-run-all -p build:lib:domain-story build:lib:dtos",
    "build:lib:domain-story": "yarn workspace @egon/vscode-domain-story build",
    "build:lib:dtos": "yarn workspace @egon/vscode-data-transfer-objects build",
    "build:webview": "yarn workspace egon-modeler-webview build",
    "build:plugin": "yarn workspace egon-modeler-plugin build",
    "dev": "npm-run-all -p dev:libs dev:webview dev:plugin",
    "dev:libs": "npm-run-all -p dev:lib:domain-story dev:lib:dtos",
    "dev:lib:domain-story": "yarn workspace @egon/vscode-domain-story dev",
    "dev:lib:dtos": "yarn workspace @egon/vscode-data-transfer-objects dev",
    "dev:webview": "yarn workspace egon-modeler-webview dev",
    "dev:plugin": "yarn workspace egon-modeler-plugin dev",
    "serve": "yarn serve:webview",
    "serve:webview": "yarn workspace egon-modeler-webview serve",
    "test": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "lodash": "4.18.1",
    "reflect-metadata": "0.2.2",
    "tslib": "2.8.1",
    "tsyringe": "4.8.0"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/lodash": "4.17.16",
    "@types/node": "22.13.4",
    "@types/vscode": "1.98.0",
    "@types/vscode-webview": "1.57.5",
    "@typescript-eslint/utils": "8.24.0",
    "@vitest/coverage-v8": "4.1.11",
    "copy-webpack-plugin": "12.0.2",
    "corepack": "0.36.0",
    "eslint": "9.20.1",
    "eslint-config-prettier": "9.1.0",
    "jsdom": "22.1.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.1",
    "terser-webpack-plugin": "5.3.11",
    "ts-archlint": "0.15.0",
    "ts-loader": "9.5.4",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.4.3",
    "vite-plugin-dts": "3.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11",
    "webpack": "5.102.1",
    "webpack-cli": "6.0.1",
    "webpack-merge": "6.0.1",
    "zip-build": "1.8.0"
  },
  "resolutions": {
    "form-data": "4.0.6",
    "shell-quote": "1.10.0",
    "tar": "7.5.22"
  }
}
